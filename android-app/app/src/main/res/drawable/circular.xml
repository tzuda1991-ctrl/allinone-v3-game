<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/secondaryProgress">
        <shape
  android:innerRadiusRatio="2.4"
  android:shape="ring"
  android:thicknessRatio="16.0"
  android:useLevel="true">
  <gradient
      android:centerColor="#26354D"
      android:endColor="#26354D"
      android:startColor="#26354D"
      android:type="sweep" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate
  android:fromDegrees="270"
  android:pivotX="50%"
  android:pivotY="50%"
  android:toDegrees="270">
  <shape
      android:innerRadiusRatio="2.4"
      android:shape="ring"
      android:thicknessRatio="16.0"
      android:useLevel="true">
      <gradient
          android:centerColor="#F5D06F"
          android:endColor="#10B981"
          android:startColor="#F5D06F"
          android:type="sweep" />
  </shape>
        </rotate>
    </item>
</layer-list>