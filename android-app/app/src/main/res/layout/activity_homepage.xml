<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/casino_lobby_background"
    tools:context=".Activity.Splashscreen"
    android:layout_centerVertical="true">

    <RelativeLayout
        android:id="@+id/rlt_parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <Button
  android:id="@+id/btnbuychips"
  android:layout_width="wrap_content"
  android:layout_height="50dp"
  android:layout_alignParentBottom="true"
  android:layout_centerInParent="true"
  android:layout_marginBottom="10dp"
  android:layout_marginLeft="10dp"
  android:background="@drawable/transparent_bg_bordered_button_red"
  android:gravity="center"
  android:paddingLeft="20dp"
  android:paddingRight="20dp"
  android:text="BUY CHIPS"
  android:textColor="#ADACAD"
  android:textSize="20dp"
  android:visibility="gone" />

        <ImageView
  android:id="@+id/imgNotification"
  android:layout_width="60dp"
  android:layout_height="60dp"
  android:layout_alignParentRight="true"
  android:layout_marginRight="10dp"
  android:layout_marginTop="10dp"
  android:src="@drawable/noti"
  android:tint="@color/colordullwhite"
  android:visibility="gone" />

        <ImageView
  android:id="@+id/imgshare"
  android:layout_width="50dp"
  android:layout_height="50dp"
  android:layout_alignParentLeft="true"
  android:layout_marginLeft="10dp"
  android:layout_marginTop="10dp"
  android:src="@drawable/share"
  android:visibility="gone" />

        <ImageView
  android:id="@+id/imalucky"
  android:layout_width="60dp"
  android:layout_height="60dp"
  android:layout_alignParentBottom="true"
  android:layout_marginBottom="10dp"
  android:layout_marginLeft="50dp"
  android:layout_toRightOf="@+id/btnbuychips"
  android:src="@drawable/lucky"
  android:visibility="gone" />

        <ImageView
  android:id="@+id/imgMywining"
  android:layout_width="50dp"
  android:layout_height="50dp"
  android:layout_alignParentRight="true"
  android:layout_margin="20dp"
  android:src="@drawable/my_winnig"
  android:visibility="gone" />

        <RelativeLayout
  android:id="@+id/rltheader"
  android:layout_width="match_parent"
  android:layout_height="76dp"
  android:background="@drawable/casino_lobby_header"
  android:paddingLeft="14dp"
  android:paddingRight="14dp">

  <RelativeLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_centerVertical="true"
      android:layout_alignParentLeft="true">

      <RelativeLayout
          android:id="@+id/rltimageptofile"
          android:layout_width="58dp"
          android:layout_height="58dp"
          android:layout_centerVertical="true"
          android:background="@drawable/casino_avatar_ring">

          <de.hdodenhof.circleimageview.CircleImageView
              android:id="@+id/imaprofile"
              android:layout_width="52dp"
              android:layout_height="52dp"
              android:layout_centerInParent="true"
              android:src="@drawable/avatar"
              app:civ_border_color="#F5D06F"
              app:civ_border_width="1.5dp" />
      </RelativeLayout>

      <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_centerVertical="true"
          android:layout_marginLeft="12dp"
          android:layout_toRightOf="@+id/rltimageptofile"
          android:orientation="vertical">

          <com.gamegards.allinonev3.Utils.TextViewWithFont
              android:id="@+id/txtproname"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Welcome Back"
              android:textColor="#F8FAFC"
              android:textSize="14sp"
              android:textStyle="bold"
              app:fontFilePath="@string/Helvetica_Bold_Extra" />

          <LinearLayout
              android:id="@+id/lnr_levels"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:orientation="vertical">

              <RelativeLayout
                  android:layout_width="wrap_content"
                  android:layout_height="30dp"
                  android:background="@drawable/casino_wallet_pill"
                  android:paddingLeft="8dp"
                  android:paddingRight="8dp">

                  <ImageView
                      android:id="@+id/imgicon"
                      android:layout_width="18dp"
                      android:layout_height="18dp"
                      android:layout_centerVertical="true"
                      android:src="@drawable/ic_vec_gold_chip" />

                  <TextView
                      android:id="@+id/txtwallet"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_centerVertical="true"
                      android:layout_marginLeft="8dp"
                      android:layout_marginRight="10dp"
                      android:layout_toRightOf="@+id/imgicon"
                      android:gravity="center"
                      android:minWidth="74dp"
                      android:text="0"
                      android:textColor="#F5D06F"
                      android:textSize="15sp"
                      android:textStyle="bold" />

                  <ImageView
                      android:id="@+id/iv_add"
                      android:layout_width="20dp"
                      android:layout_height="20dp"
                      android:layout_centerVertical="true"
                      android:layout_toRightOf="@+id/txtwallet"
                      android:src="@drawable/ic_refresh" />
              </RelativeLayout>
          </LinearLayout>
      </LinearLayout>
  </RelativeLayout>

  <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_alignParentRight="true"
      android:layout_centerVertical="true"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <LinearLayout
          android:id="@+id/lnrbuychips"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginRight="10dp"
          android:orientation="vertical">

          <ImageView
              android:id="@+id/imgbuychips"
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:background="@drawable/casino_top_gold_btn"
              android:padding="9dp"
              android:src="@drawable/ic_vec_cart" />

          <com.gamegards.allinonev3.Utils.TextViewWithFont
              android:id="@+id/txtBuyChips"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Buy Chips"
              android:textColor="@color/colordullwhite"
              android:textSize="12sp"
              android:visibility="gone" />
      </LinearLayout>

      <LinearLayout
          android:id="@+id/lnrinvite"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginRight="10dp"
          android:orientation="vertical">

          <ImageView
              android:id="@+id/imginvite"
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:background="@drawable/casino_top_icon_btn"
              android:padding="9dp"
              android:src="@drawable/ic_vec_invite" />

          <com.gamegards.allinonev3.Utils.TextViewWithFont
              android:id="@+id/txtInvite"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Invite"
              android:textColor="@color/colordullwhite"
              android:textSize="12sp"
              android:visibility="gone" />
      </LinearLayout>

      <LinearLayout
          android:id="@+id/lnrmail"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginRight="10dp"
          android:orientation="vertical">

          <ImageView
              android:id="@+id/imgMail"
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:background="@drawable/casino_top_icon_btn"
              android:padding="9dp"
              android:src="@drawable/ic_vec_mail" />

          <com.gamegards.allinonev3.Utils.TextViewWithFont
              android:id="@+id/txtMail"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Mail"
              android:textColor="@color/colordullwhite"
              android:textSize="12sp"
              android:visibility="gone" />
      </LinearLayout>

      <LinearLayout
          android:id="@+id/lnrearnchips"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginRight="10dp"
          android:orientation="vertical"
          android:visibility="gone">

          <ImageView
              android:id="@+id/imgearnchips"
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:background="@drawable/casino_top_icon_btn"
              android:padding="9dp"
              android:src="@drawable/ic_vec_trophy" />

          <com.gamegards.allinonev3.Utils.TextViewWithFont
              android:id="@+id/txtEarn"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Leader Board"
              android:textColor="@color/colordullwhite"
              android:textSize="12sp"
              android:visibility="gone" />
      </LinearLayout>

      <LinearLayout
          android:id="@+id/lnrhistory"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginRight="10dp"
          android:orientation="vertical">

          <ImageView
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:background="@drawable/casino_top_icon_btn"
              android:padding="9dp"
              android:src="@drawable/ic_vec_trophy" />
      </LinearLayout>

      <LinearLayout
          android:id="@+id/lnrvideo"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginRight="10dp"
          android:orientation="vertical"
          android:visibility="gone">

          <ImageView
              android:id="@+id/imgvideo"
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:background="@drawable/casino_top_icon_btn"
              android:padding="9dp"
              android:src="@drawable/ic_vec_gift" />

          <com.gamegards.allinonev3.Utils.TextViewWithFont
              android:id="@+id/txtvideo"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Rewards"
              android:textColor="@color/colordullwhite"
              android:textSize="12sp"
              android:visibility="gone" />
      </LinearLayout>

      <LinearLayout
          android:id="@+id/lnr_redeem"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginRight="10dp"
          android:orientation="vertical"
          android:visibility="visible">

          <ImageView
              android:id="@+id/iv_redeem"
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:background="@drawable/casino_top_icon_btn"
              android:padding="9dp"
              android:src="@drawable/ic_vec_gift" />

          <com.gamegards.allinonev3.Utils.TextViewWithFont
              android:id="@+id/tv_redeem"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Redeem"
              android:textColor="@color/colordullwhite"
              android:textSize="12sp"
              android:visibility="gone" />
      </LinearLayout>

      <LinearLayout
          android:id="@+id/lnrsetting"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginRight="10dp"
          android:orientation="vertical">

          <ImageView
              android:id="@+id/imgsetting"
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:background="@drawable/casino_top_icon_btn"
              android:padding="9dp"
              android:src="@drawable/ic_vec_settings" />

          <com.gamegards.allinonev3.Utils.TextViewWithFont
              android:id="@+id/txtLogout"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Setting"
              android:textColor="@color/colordullwhite"
              android:textSize="12sp"
              android:visibility="gone" />
      </LinearLayout>

      <LinearLayout
          android:id="@+id/lnrlogout"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="vertical">

          <ImageView
              android:id="@+id/imgLogout"
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:background="@drawable/casino_top_icon_btn"
              android:padding="9dp"
              android:src="@drawable/ic_vec_more" />

          <com.gamegards.allinonev3.Utils.TextViewWithFont
              android:id="@+id/txtlogout"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="More"
              android:textColor="@color/colordullwhite"
              android:textSize="12sp"
              android:visibility="gone" />
      </LinearLayout>
  </LinearLayout>
        </RelativeLayout>

        <TextView
  android:id="@+id/casino_lobby_title"
  android:layout_width="wrap_content"
  android:layout_height="23dp"
  android:layout_below="@id/rltheader"
  android:layout_marginLeft="15dp"
  android:layout_marginTop="6dp"
  android:gravity="center"
  android:letterSpacing="0.12"
  android:paddingRight="20dp"
  android:text="THE CARD ROOM"
  android:textColor="#F5D06F"
  android:textSize="12sp"
  android:textStyle="bold" />

        <View android:id="@+id/shine" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <View android:id="@+id/v_flesh" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />

        <LinearLayout
  android:id="@+id/hsv_view"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:layout_below="@id/casino_lobby_title"
  android:layout_marginTop="8dp"
  android:layout_marginBottom="12dp"
  android:gravity="center"
  android:orientation="horizontal"
  android:paddingLeft="12dp"
  android:paddingRight="12dp">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:background="@drawable/lobby_card_shell">

                <ImageView
                    android:id="@+id/imgpublicGame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:contentDescription="Play Teen Patti"
                    android:src="@drawable/lobby_art_teen" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="@drawable/lobby_card_shade"
                    android:orientation="vertical"
                    android:padding="9dp"
                    android:importantForAccessibility="noHideDescendants">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CLASSIC TABLE"
                        android:textColor="#E3C18B"
                        android:textSize="9sp"
                        android:letterSpacing="0.08" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Teen Patti"
                        android:textColor="#FFF4DE"
                        android:textSize="18sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Play  ›"
                        android:textColor="#ECD4A8"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:background="@drawable/lobby_card_shell">

                <ImageView
                    android:id="@+id/imgPrivategame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:contentDescription="Play Private Table"
                    android:src="@drawable/lobby_art_private" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="@drawable/lobby_card_shade"
                    android:orientation="vertical"
                    android:padding="9dp"
                    android:importantForAccessibility="noHideDescendants">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="INVITE FRIENDS"
                        android:textColor="#E3C18B"
                        android:textSize="9sp"
                        android:letterSpacing="0.08" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Private Table"
                        android:textColor="#FFF4DE"
                        android:textSize="18sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Play  ›"
                        android:textColor="#ECD4A8"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:background="@drawable/lobby_card_shell">

                <ImageView
                    android:id="@+id/ImgCustomePage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:contentDescription="Play Custom Boot"
                    android:src="@drawable/lobby_art_custom" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="@drawable/lobby_card_shade"
                    android:orientation="vertical"
                    android:padding="9dp"
                    android:importantForAccessibility="noHideDescendants">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SET YOUR STAKES"
                        android:textColor="#E3C18B"
                        android:textSize="9sp"
                        android:letterSpacing="0.08" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Custom Boot"
                        android:textColor="#FFF4DE"
                        android:textSize="18sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Play  ›"
                        android:textColor="#ECD4A8"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:background="@drawable/lobby_card_shell">

                <ImageView
                    android:id="@+id/ImgVariationGane"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:contentDescription="Play Rummy"
                    android:src="@drawable/lobby_art_rummy" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="@drawable/lobby_card_shade"
                    android:orientation="vertical"
                    android:padding="9dp"
                    android:importantForAccessibility="noHideDescendants">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="13 CARDS"
                        android:textColor="#E3C18B"
                        android:textSize="9sp"
                        android:letterSpacing="0.08" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Rummy"
                        android:textColor="#FFF4DE"
                        android:textSize="18sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Play  ›"
                        android:textColor="#ECD4A8"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:background="@drawable/lobby_card_shell">

                <ImageView
                    android:id="@+id/iv_andher"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:contentDescription="Play Andar Bahar"
                    android:src="@drawable/lobby_art_andar" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="@drawable/lobby_card_shade"
                    android:orientation="vertical"
                    android:padding="9dp"
                    android:importantForAccessibility="noHideDescendants">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CARD DUEL"
                        android:textColor="#E3C18B"
                        android:textSize="9sp"
                        android:letterSpacing="0.08" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Andar Bahar"
                        android:textColor="#FFF4DE"
                        android:textSize="18sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Play  ›"
                        android:textColor="#ECD4A8"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <RelativeLayout
  android:id="@+id/rltBottom"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_alignParentBottom="true"
  android:visibility="gone">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">

      <LinearLayout
          android:id="@+id/lnr_social"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="bottom"
          android:layout_marginLeft="5dp"
          android:layout_weight="1"
          android:gravity="bottom"
          android:orientation="vertical">

          <ImageView
              android:layout_width="100dp"
              android:layout_height="20dp"
              android:src="@drawable/ic_s_media" />

          <com.gamegards.allinonev3.Utils.TextViewWithFont
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Joint us"
              android:textAllCaps="true"
              android:textColor="@color/colordullwhite"
              android:textSize="12sp"
              android:textStyle="bold"
              android:visibility="visible" />
      </LinearLayout>
  </LinearLayout>
        </RelativeLayout>

        <RelativeLayout
  android:id="@+id/rlt_animation_layout"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:gravity="center"
  android:visibility="gone" />

        <com.gamegards.allinonev3.Utils.TextViewWithFont
  android:id="@+id/txtName"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:layout_centerHorizontal="true"
  android:layout_marginTop="40dp"
  android:text="Welcome Back"
  android:textColor="@color/colordullwhite"
  android:textSize="20dp"
  android:textStyle="bold"
  android:visibility="gone" />
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/home_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</androidx.constraintlayout.widget.ConstraintLayout>